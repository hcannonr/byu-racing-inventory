# Vercel → Project → Settings → Environment Variables (Production only).
# Real values live with the club admin. Never commit a filled-in copy.

# Exact site address, no trailing slash. Must match the URL people open.
INVENTORY_APP_ORIGIN=https://your-project.vercel.app

# Supabase → Project Settings → Database / API.
# Use the restricted racing_app connection string, not the admin password.
INVENTORY_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The first person allowed in as admin.
INVENTORY_BOOTSTRAP_ADMIN_EMAIL=

# 32+ random characters. Signs QR label links and the scheduled job.
# Changing it breaks every printed label (reprint them) and must match Supabase Vault racing_worker_secret.
INVENTORY_JOB_SECRET=

# Optional: buyer emails. Without these, emails show as "Not sent".
RESEND_API_KEY=
INVENTORY_EMAIL_FROM=
